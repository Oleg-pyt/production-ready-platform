################################

# Ignore folders in all depths

################################
**/.idea
**/target
**/.generated
**/.angular
**/dist
**/node_modules
**/.git

################################

# Java build files

################################
**/*.class
**/*.jar
**/*.war
**/*.ear
**/*.nar
**/*.log

# Allow the backend fat-jar produced by the root Maven build
!backend/target/backend-*.jar

################################

# Logs

################################
**/logs
**/*.log

################################

# Environment

################################
**/.env
**/.env.*

################################

# OS files

################################
**/.DS_Store
**/Thumbs.db

################################

# IDE

################################
**/*.iml
**/.vscode
